# =============================================================================
# wallpaper-auto-marketing - bien moi truong
#
# Cach 1 (khuyen nghi): chay `npx wam serve` roi ket noi kenh bang OAuth trong
#   web admin. Khi do ban CHI can dat WAM_ADMIN_TOKEN (neu mo ra ngoai localhost).
#
# Cach 2: dung module truc tiep trong code/cron -> dat cac bien duoi day va goi
#   `createPosterFromEnv()`.
# =============================================================================

# ---------------------------------------------------------------- web admin
# Token dang nhap web admin. Bo trong = chi truy cap duoc tu localhost.
WAM_ADMIN_TOKEN=
# Thu muc luu kenh/bai dang/media (mac dinh ./data)
WAM_DATA_DIR=./data
# Cong va host cua web admin
PORT=4000
WAM_HOST=127.0.0.1
# URL cong khai cua admin (bat buoc dat dung neu chay sau reverse proxy,
# vi OAuth redirect_uri phai khop chinh xac)
# WAM_PUBLIC_URL=https://admin.example.com

# ----------------------------------------------------------------- chung
WAM_LOG_LEVEL=info
WAM_LOG_FORMAT=pretty
WAM_CONCURRENCY=3
WAM_DRY_RUN=false
# Noi luu access token de khong phai refresh lai moi lan chay
WAM_TOKEN_STORE=./data/tokens.json

# --------------------------------------------------------------- YouTube
# Google Cloud Console > bat "YouTube Data API v3" > tao OAuth Client ID
# Lay refresh token bang web admin (tab Kenh) hoac OAuth Playground.
# LUU Y: OAuth consent screen o che do "Testing" -> refresh token het han sau 7 NGAY.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_NOTIFY_SUBSCRIBERS=false
# YOUTUBE_PLAYLIST_ID=

# -------------------------------------------------------------- Facebook
# PAGE access token phai duoc tao tu USER token DAI HAN, neu khong se het han sau 1-2 gio.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_PUBLISHED=true
FACEBOOK_AS_REEL=false
# Chi can khi dung Resumable Upload API cho video > 1GB
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ------------------------------------------------------------- Instagram
# igUserId lay tu: GET /{page-id}?fields=instagram_business_account
# Tai khoan phai la Business/Creator va lien ket voi Facebook Page.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SHARE_TO_FEED=true
INSTAGRAM_USE_INSTAGRAM_LOGIN=false

# ---------------------------------------------------------------- TikTok
# developers.tiktok.com > bat "Content Posting API"
# App CHUA audit chi dang duoc privacy_level=SELF_ONLY.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_POST_MODE=DIRECT_POST

# -------------------------------------------------------------- Telegram
# Token tu @BotFather. Bot phai la ADMIN cua channel va co quyen "Post Messages".
# chatId: @tenchannel (public) hoac -1001234567890 (private). Nhieu chat: cach nhau dau phay.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_NOTIFICATION=false

# ------------------------------------------- media cong khai (S3/R2/MinIO)
# Instagram (anh) va TikTok (anh) CHI nhan URL cong khai, khong cho upload file.
# Cau hinh S3 de module tu dua file len roi xoa sau khi dang.
WAM_S3_BUCKET=
WAM_S3_REGION=auto
WAM_S3_ENDPOINT=
WAM_S3_ACCESS_KEY_ID=
WAM_S3_SECRET_ACCESS_KEY=
WAM_S3_PUBLIC_BASE_URL=
WAM_S3_FORCE_PATH_STYLE=false
WAM_S3_DELETE_AFTER_POST=true

# Hoac dung tunnel tro ve may nay (ngrok / cloudflared)
# WAM_PUBLIC_BASE_URL=https://abc.trycloudflare.com
# WAM_PUBLIC_PORT=8787

# ffprobe de doc thoi luong/kich thuoc video (tuy chon nhung nen co)
# FFPROBE_PATH=ffprobe
